pipeline {
  agent {
    docker {
      image 'abhishekf5/maven-abhishek-docker-agent:v1'
      args '--entrypoint="" --user root -v /var/run/docker.sock:/var/run/docker.sock'
    }
  }
  options {
    skipDefaultCheckout()
    buildDiscarder(logRotator(numToKeepStr: '5'))
  }
  stages {
    stage('Checkout and Clean') {
      steps {
        sh 'rm -rf java-maven-sonar-argocd-helm-k8s/spring-boot-app/target .git/objects || true'
        checkout scm
      }
    }
    stage('Build Artifact') {
      steps {
        sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn clean package'
      }
    }
    stage('Static Code Analysis') {
      environment {
        SONAR_URL = "http://172.17.0.2:9000"
      }
      steps {
        withCredentials([string(credentialsId: 'Sonar-token', variable: 'SONAR_AUTH_TOKEN')]) {
          sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn org.sonarsource.scanner.maven:sonar-maven-plugin:3.9.1.2184:sonar -Dsonar.login=$SONAR_AUTH_TOKEN -Dsonar.host.url=${SONAR_URL}'
        }
      }
    }
    stage('Build and Push Docker Image') {
      environment {
        DOCKER_IMAGE = "surajpatil1/ultimate-cicd:${BUILD_NUMBER}"
      }
      steps {
        script {
            // Install static Docker CLI binary to bypass container GLIBC mismatch
            sh '''
                curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-24.0.7.tgz -o docker.tgz
                tar xzvf docker.tgz
                cp docker/docker /usr/local/bin/docker
                rm -rf docker.tgz docker
                docker --version
            '''
            
            sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && docker build -t ${DOCKER_IMAGE} .'
            
            withCredentials([usernamePassword(credentialsId: 'docker-cred', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                sh '''
                    python3 -c '
import base64, json, os
user = os.environ["DOCKER_USER"].strip().lower()
pwd = os.environ["DOCKER_PASS"].strip()
auth_str = f"{user}:{pwd}"
encoded_auth = base64.b64encode(auth_str.encode("utf-8")).decode("utf-8")

config_data = {
    "auths": {
        "https://index.docker.io/v1/": {
            "auth": encoded_auth
        },
        "https://registry-1.docker.io/": {
            "auth": encoded_auth
        }
    }
}

docker_dir = os.path.expanduser("~/.docker")
os.makedirs(docker_dir, exist_ok=True)
with open(os.path.join(docker_dir, "config.json"), "w") as f:
    json.dump(config_data, f)
print(f"Docker auth config generated successfully for lowercase user: {user}")
                    '
                    docker push ${DOCKER_IMAGE}
                '''
            }
        }
      }
    }
    stage('Update Manifests Repository') {
        steps {
            withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                sh '''
                    git config --global user.email "suraj@example.com"
                    git config --global user.name "SurajPatil51"
                    
                    # Clean up any old clone attempts
                    rm -rf cicd-manifests
                    
                    # Clone the separate manifests repository using the GitHub token
                    git clone https://${GITHUB_TOKEN}@github.com/SurajPatil51/cicd-manifests.git
                    
                    cd cicd-manifests
                    
                    # Update the image tag dynamically
                    sed -i "s|surajpatil1/ultimate-cicd:.*|surajpatil1/ultimate-cicd:${BUILD_NUMBER}|g" deployment.yml
                    
                    git add deployment.yml
                    git commit -m "GitOps: update image tag to ${BUILD_NUMBER}"
                    
                    # Push back to the manifests repo
                    git push https://${GITHUB_TOKEN}@github.com/SurajPatil51/cicd-manifests.git HEAD:main
                '''
            }
        }
    }
  }
}

//testing for argo cd